# ─────────────────────────────────────────────────────────────────────────────
# Production environment template
# Copy this file to .env.prod and fill in all values before deploying.
# .env.prod is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=saleor
POSTGRES_USER=saleor
POSTGRES_PASSWORD=change-me-strong-password

# Full database URL for Django (must match the postgres service credentials above)
DATABASE_URL=postgres://saleor:change-me-strong-password@postgres:5432/saleor

# ── Redis ─────────────────────────────────────────────────────────────────────
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-real-secret-key

# Comma-separated list — your EC2 public IP or domain
ALLOWED_HOSTS=your-ec2-ip-or-domain.com
ALLOWED_CLIENT_HOSTS=your-ec2-ip-or-domain.com

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public URL of the Saleor API (used for webhooks, emails, etc.)
PUBLIC_URL=http://your-ec2-ip-or-domain.com

# URL where the dashboard is served
DASHBOARD_URL=http://your-ec2-ip-or-domain.com/dashboard/

# ── Dashboard build args (baked into JS bundle at build time) ─────────────────
API_URL=http://your-ec2-ip-or-domain.com/graphql/

# ── Storefront build args (baked into JS bundle at build time) ────────────────
NEXT_PUBLIC_SALEOR_API_URL=http://your-ec2-ip-or-domain.com/graphql/
NEXT_PUBLIC_STOREFRONT_URL=http://your-ec2-ip-or-domain.com
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# ── Email ─────────────────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=noreply@your-domain.com
# SMTP example: smtp://user:password@smtp.provider.com:587/?ssl=True
EMAIL_URL=smtp://localhost:25

# ── Optional ──────────────────────────────────────────────────────────────────
# HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# AWS_MEDIA_BUCKET_NAME=your-s3-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
