{
  "family": "saleor-backend-manage",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::249297038289:role/ecsTaskRole",
  "taskRoleArn": "arn:aws:iam::249297038289:role/ecsTaskRole",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "saleor-manage",
      "image": "249297038289.dkr.ecr.us-east-1.amazonaws.com/saleor-backend:latest",
      "entryPoint": ["sh", "-c"],
      "command": ["echo 'Provide command via overrides'"],
      "essential": true,
      "environment": [
        { "name": "DEBUG", "value": "True" },
        { "name": "PUBLIC_URL", "value": "https://dev.learnwithvinay.in" },
        { "name": "AWS_MEDIA_BUCKET_NAME", "value": "saleor-media-dev-learnwithvinay" },
        { "name": "AWS_STORAGE_BUCKET_NAME", "value": "saleor-media-dev-learnwithvinay" },
        { "name": "AWS_S3_REGION_NAME", "value": "us-east-1" },
        { "name": "AWS_MEDIA_CUSTOM_DOMAIN", "value": "saleor-media-dev-learnwithvinay.s3.amazonaws.com" },
        { "name": "AWS_DEFAULT_ACL", "value": "public-read" },
        { "name": "AWS_QUERYSTRING_AUTH", "value": "False" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:249297038289:secret:saleor/dev-xSjh9Z:DATABASE_URL::"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:249297038289:secret:saleor/dev-xSjh9Z:SECRET_KEY::"
        },
        {
          "name": "CELERY_BROKER_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:249297038289:secret:saleor/dev-xSjh9Z:CELERY_BROKER_URL::"
        },
        {
          "name": "CACHE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:249297038289:secret:saleor/dev-xSjh9Z:CACHE_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/saleor-backend-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "manage",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
